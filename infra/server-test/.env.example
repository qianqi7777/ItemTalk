# 仅供隔离测试；实际文件为 .env 和 .env.providers，均不得提交。
RELEASE_SHA=<exact-40-character-commit>
TEST_DB_IMAGE=<existing-pgvector-image-sha256-ID>
DB_ADMIN_PASSWORD=<fresh-test-only-password>
DB_PASSWORD=<fresh-test-only-password>
DB_MIGRATION_PASSWORD=<fresh-test-only-password>
DB_WORKER_PASSWORD=<fresh-test-only-password>
JWT_SECRET=<fresh-test-only-secret>
# .env.providers 仅放 MODEL_*/CHAT_MODEL/VISION_*/EMBEDDING_*/SEARCH_*/STT_*。
# 从已授权本地配置按白名单复制；不能复制 DATABASE_URL、COS_* 或备份凭据。
