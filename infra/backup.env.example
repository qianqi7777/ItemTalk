# 服务器 /opt/itemtalk/.env.backup，owner ubuntu、0600；不提交真实文件。
# 当前阶段保持false；真实验收与上线确认后才启用定时任务。
BACKUP_JOBS_ENABLED=false
BACKUP_SOURCE_REGION=ap-beijing
# 独立数据库备份桶，不能填入应用COS_BUCKET，也不能复用应用删除权限。
DB_BACKUP_COS_BUCKET=itemtalk-backup-1314964135
DB_BACKUP_COS_REGION=ap-nanjing
DB_BACKUP_COS_SECRET_ID=
DB_BACKUP_COS_SECRET_KEY=
# 代码固定本地7天；仅清理已上传核验的自身备份，COS不删除、不设置过期规则。
# 告警联系人、CLS主题与邮件模板待配置；此模板不会创建规则或发送邮件。
OPS_ALERTS_ENABLED=false
TCOP_REGION=ap-beijing
TCOP_CLS_TOPIC_ID=
TCOP_NOTIFICATION_TEMPLATE_ID=
TCOP_ALERT_CONTACT_GROUP_ID=
TCOP_CLS_NOTICE_GROUP_ID=
# 可选SMTP后备。独立测试开关默认false，不启用生产OPS_ALERTS_ENABLED。
OPS_ALERT_CHANNEL=tcop
OPS_SMTP_TEST_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# 在云控制台验证邮件地址；不要把邮箱、令牌或凭据写进日志事件。
