# 仅独立验收环境；复制为backend/.env.acceptance，真实文件不可提交。
# 所有数据库连接须显式填写，禁止填写生产库。准备具有完整角色/扩展的测试PG16。
DB_HOST=127.0.0.1
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# 源资产为独立验收用COS资产桶，不能使用数据库备份桶；凭据只需读取已准备样本。
STORAGE_BACKEND=cos
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
BACKUP_SOURCE_REGION=ap-beijing
# MODEL_PROVIDER由备份CLI固定mock；不调用模型。
