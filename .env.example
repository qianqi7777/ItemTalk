# Copy to local .env or server-only .env.production. Never commit real values.
ENVIRONMENT=production
STORAGE_BACKEND=cos
STORAGE_DIRECTORY=.local-data/assets
DB_ADMIN_PASSWORD=
DB_MIGRATION_PASSWORD=
DB_PASSWORD=
DB_WORKER_PASSWORD=
JWT_SECRET=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_PATH=/itemtalk/
PUBLIC_PATH_PREFIX=/itemtalk
APP_PUBLIC_URL=https://49.233.65.195/itemtalk/
# Mainland China: replace <WorkspaceId> with your Beijing workspace ID.
MODEL_PROVIDER=dashscope
MODEL_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
# Optional admin-managed text models: independent Fernet key, shared by API/Worker.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep in restricted server configuration and paired backups; never rotate without re-encrypting profiles.
MODEL_CONFIG_ENCRYPTION_KEY=
CHAT_MODEL=qwen3.7-flash
# Responses 接入；旧环境可保留 chat_completions，后台配置优先于预设。
CHAT_API_PROTOCOL=responses
VISION_PROVIDER=dashscope
VISION_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen3.7-flash
VISION_API_PROTOCOL=responses
# 仅在已验证百炼图搜图工具后开启；普通问答和扫描页 OCR 不调用搜图。
VISION_IMAGE_SEARCH_ENABLED=false
EMBEDDING_PROVIDER=dashscope
EMBEDDING_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_REVISION=bailian-beijing-v4-2026-10-13
SEARCH_PROVIDER=bocha
SEARCH_BASE_URL=https://api.bochaai.com/v1/web-search
SEARCH_API_KEY=
DAILY_MODEL_CALL_LIMIT=100
DAILY_GLOBAL_MODEL_CALL_LIMIT=1000
RATE_LIMIT_PER_MINUTE=60
STT_PROVIDER=dashscope
STT_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
STT_API_KEY=
STT_MODEL=qwen3-asr-flash
CHAT_TIMEOUT_SECONDS=45
VISION_TIMEOUT_SECONDS=60
EMBEDDING_TIMEOUT_SECONDS=30
STT_TIMEOUT_SECONDS=60
SEARCH_TIMEOUT_SECONDS=20
SEARCH_MAX_RESULTS=10
UPSTREAM_MAX_ATTEMPTS=2
# Keep system DNS in production; cloudflare is optional for a local Fake-IP network.
FETCH_DNS_PROVIDER=system
TTS_PROVIDER=
TTS_API_KEY=
COS_SECRET_ID=
BACKUP_COS_SECRET_ID=
BACKUP_COS_SECRET_KEY=
# 上述BACKUP_COS凭据仅用于只读应用资产。数据库备份桶使用
# infra/backup.env.example -> 服务器受限.env.backup，与应用桶隔离。
# Set to the verified UID/GID of the backup directory owner.
BACKUP_UID=1000
BACKUP_GID=1001
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-beijing
# Standalone HTTPS only; fixed IMAGE_TAG/RELEASE_SHA come from release .env.image_tag.
SITE_ADDRESS=49.233.65.195
# V2在迁移和隔离验收后启用；现有V1部署默认关闭。
V2_ENABLED=false
RUNTIME_GLOBAL_HARD_LIMIT=1000
RUNTIME_SUBJECT_HARD_LIMIT=100
QUERY_CACHE_TTL_SECONDS=86400
# 仅已通过JSON/SSE/工具/质量真实验收后才将accepted改为true。
MODEL_PROFILES={"quality":{"model":"qwen3.7-plus","accepted":false}}
# 带effective_from日期的配置价格；空列表表示所有调用未计价，不是免费。
MODEL_PRICES=[]
# 仅隔离真实验收设置唯一ID；累计上限含重试，不以日期或账号重置。
ACCEPTANCE_RUN_ID=
ACCEPTANCE_CALL_BUDGET=300
